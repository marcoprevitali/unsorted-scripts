model new
[cone_rad1 = 0.5]
[cone_rad2 = 1.0]
[cone_height = 1.5]
[cyl_height = 2]
[domain_x = 0.125]
[domain_y = 0.125]
[domain_depth = 3]
[maxEdge = 0.5]

model domain extent [-domain_x*3] [domain_x*3] [-domain_y*3] [domain_y*3] [-domain_depth*3] [domain_depth*3] 
;
;geometry set 'cut'
;
;geometry generate cylinder base 0 0 [-cyl_height] radius [cone_rad1] ...
;                  height [cyl_height] axis 0 0 1 resolution 0.4 
;                  
;wall generate cylinder base 0 0 [-cyl_height] radius [cone_rad1] ...
;    height [cyl_height+1e-3] axis 0 0 1 resolution 0.4
;
;geometry generate cone base 0 0 [-cyl_height-cone_height] radius [cone_rad2] [cone_rad1] ...
;                  height [cone_height] axis 0 0 1 resolution 0.4
;
;wall generate cone base 0 0 [-cyl_height-cone_height] radius [cone_rad2] [cone_rad1] ...
;                  height [cone_height] axis 0 0 1 resolution 0.4
;
;geometry set 'cubotto'
;geometry generate box [-domain_x] [domain_x] [-domain_y] [domain_y] [-domain_depth] 0
;
;geometry node extra 1 [maxEdge]
;
;[lb = vector(-domain_x,-domain_y,-domain_depth)]
;[ub = vector(domain_x,domain_y,0.0)]
;

; Create walls extending past the edges of the sample

program call 'generate_tetra_gmsh.py'
;program call '01_stress'
;program call '03_UCT.dat'

