;[addExtra]
;rblock construct from-geometry 'cubotto' maximum-edge [maxEdge] internal

;rblock scale relative 1.01 keep-inertial
[thrs = 0.12]
;need to do this because rblocks act different for some reason?
fish define getBoundary
    loop foreach rb rblock.list
        pmin = rblock.facet.vertex.pos.y(rb,1,1)
        pmax = rblock.facet.vertex.pos.y(rb,1,1)
        loop i(1,rblock.facet.num(rb))
            pmin = math.min(rblock.facet.vertex.pos.y(rb,i,1),pmin)
            pmax = math.max(rblock.facet.vertex.pos.y(rb,i,1),pmax)
            pmin = math.min(rblock.facet.vertex.pos.y(rb,i,2),pmin)
            pmax = math.max(rblock.facet.vertex.pos.y(rb,i,2),pmax)
            pmin = math.min(rblock.facet.vertex.pos.y(rb,i,3),pmin)
            pmax = math.max(rblock.facet.vertex.pos.y(rb,i,3),pmax)
        endloop
        if pmin < -domain_y + thrs
            rblock.group(rb,'boundary') = 'boundary'
        endif
        if pmax > domain_y - thrs
            rblock.group(rb,'boundary') = 'boundary'
        endif
        
        pmin = rblock.facet.vertex.pos.x(rb,1,1)
        pmax = rblock.facet.vertex.pos.x(rb,1,1)
        loop i(1,rblock.facet.num(rb))
            pmin = math.min(rblock.facet.vertex.pos.x(rb,i,1),pmin)
            pmax = math.max(rblock.facet.vertex.pos.x(rb,i,1),pmax)
            pmin = math.min(rblock.facet.vertex.pos.x(rb,i,2),pmin)
            pmax = math.max(rblock.facet.vertex.pos.x(rb,i,2),pmax)
            pmin = math.min(rblock.facet.vertex.pos.x(rb,i,3),pmin)
            pmax = math.max(rblock.facet.vertex.pos.x(rb,i,3),pmax)
        endloop
        if pmin < -domain_x + thrs
            rblock.group(rb,'boundary') = 'boundary'
        endif
        if pmax > domain_x - thrs
            rblock.group(rb,'boundary') = 'boundary'
        endif
        
        pmin = rblock.facet.vertex.pos.z(rb,1,1)
        pmax = rblock.facet.vertex.pos.z(rb,1,1)
        loop i(1,rblock.facet.num(rb))
            pmin = math.min(rblock.facet.vertex.pos.z(rb,i,1),pmin)
            pmax = math.max(rblock.facet.vertex.pos.z(rb,i,1),pmax)
            pmin = math.min(rblock.facet.vertex.pos.z(rb,i,2),pmin)
            pmax = math.max(rblock.facet.vertex.pos.z(rb,i,2),pmax)
            pmin = math.min(rblock.facet.vertex.pos.z(rb,i,3),pmin)
            pmax = math.max(rblock.facet.vertex.pos.z(rb,i,3),pmax)
        endloop
        if pmin < -domain_depth + thrs
            rblock.group(rb,'boundary') = 'boundary'
        endif

        
    endloop
end
@getBoundary

; Import the geometry polygons as fractures for cutting
;fracture import from-geometry 'cut' 

; Cut the rigid blocks, making sure not to cut those not intersected 
; by the tunnel boundary
;rblock cut fractures 'cut' throughgoing group 'supportBlock' ... 
;                                  intersects-box [-domain_x] [domain_x] [-domain_y] [domain_y] [-domain_depth] 0 ...
;                                  sliver-remove false sliver-group 'sliver' slot 'sliver'
;
;
;rblock group 'cut' range geometry-space 'cut' ...
;                            count odd position-x -1 1

;rblock scale relative 1.01 keep-inertial

model save 'geom_init'
