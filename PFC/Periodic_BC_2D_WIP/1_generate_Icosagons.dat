model new
model large-strain on
program echo off
model random 10002


 [scale   = 1]  ; amplification factor for ball size in order to reduce number of particles
 [flag_porosity = 0]   ;see eps_ini
 [ngranu = 100]         ;number of cycles to calculate PSD 
 [c_fri   = .2]    ; contact friction
 [c_fri_wall   = .0]    ; contact friction
 [d_dens  = 2.71]   ; ball density
 [poros   = 0.167]   ; desired final porosity
 [width   = .35]  ; width of box
 [height   = .35]  ; height of box
 
 
 ; shape parameters, diameters, etc..
 ; the percentage of solid volume occupied by each of these shapes
 [solid_vol_triangles = 0]
 [solid_vol_hexagons = 0]
 [solid_vol_circles = 0]
 [solid_vol_squares = 0]
 [solid_vol_pentagons = 0]
 [solid_vol_heptagons = 0]
 [solid_vol_icosagons = 100]
 
 ;in icosagon case, area is calculated by side length so here diam1 and diam2 are side lengths
 [diam1 = 0.001584] ;for 10mm inscribed diameter >> 1.584mm is side length
 [diam2 = 0.0009503] ;for 6mm inscribed diameter >> 0.9503mm is side length
 [perc1 = 40]
 [perc2 = 60]
 
 
 
 
 
 [init_scale = 0.8/2];
;********************************************* hertz
;
 [_nu = 0.3]			;poisson
 [_g = 26.e6]			;shear
 [_nu_wall = 0.3]		;poisson wall
 [_g_wall = 26.e6]		;shear wall
;
;*********************************************

[porosity_type = 0]



model domain extent 0.0 @width 0.0 @height;[-2*width] [2*width] [-2*height] [2*height] 
model domain condition periodic

; generate the box
;wall generate box 0.0 @width 0.0 @height expand 1.8; extend the wall to be able to use servos without breaking the box
;[wall_bottom = wall.find(1)]
;[wall_right = wall.find(2)]
;[wall_top = wall.find(3)]
;[wall_left = wall.find(4)]

call 'generate_mix.py'

;what is this
[masse = height * diam1 * d_dens * (1.0-poros)]
[massa = width * diam1 * d_dens*(1.0-poros)]


def contact_law_to_use
        command
        contact cmat default model hertz ;...
        ;    property   hz_shear @_g ...
        ;               hz_poiss @_nu ...
        ;               fric @c_fri
        rblock attribute density @d_dens
        ;ball attribute density @d_dens
        rblock property 'hz_shear' @_g ...
                      'hz_poiss' @_nu ...
                      'fric' @c_fri
        ;ball property 'hz_shear' @_g ...
        ;'hz_poiss' @_nu ...
        ;'fric' @c_fri
        wall property 'hz_shear' @_g_wall ...
                      'hz_poiss' @_nu_wall ...
                      'fric' @c_fri_wall
        endcommand 
end
@contact_law_to_use


def get_poros
sum = 0.0
sum_2 =0.0
loop foreach rb rblock.list
sum = sum + rblock.vol(rb)
endloop
loop foreach b ball.list
sum = sum + ball.vol(b)
endloop
pmeas = 1.0 - sum/(height*width)
pmeas_2 = pmeas
end
@get_poros


def mult_fact ;calculate the multiplier factor for the radii expansion method
mult = (((1.0 - poros) / (1.0 - pmeas)))
mult_fact = mult^(1./10.)
end
@mult_fact
list @mult

rblock property 'fric' 0.0 ; so we don't have locking during ball expansion
rblock attribute velocity-x  0.0 velocity-y 0.0 

def mult_rblocks ;expand the particles
 loop i(1,10)
 loop foreach rb rb.list
 target_vol = rb.vol(rb) * mult_fact
 rb.scalevol(rb,target_vol)
 endloop
   command
    model cycle 200 calm 100
   endcommand
 endloop
 loop foreach rb rblock.list
    sum = sum + rblock.vol(rb)
    sum_2 = sum 
end_loop 
 end
 
 @get_poros
 @mult_rblocks
 @get_poros
 
 list @pmeas
 list @poros
[y_compression = 0]
[tsxx= 0]
[tsyy=0]
call 'python_functions_periodic.py'

cy 1
 


; set the history variables
fish history @eps_y
fish hist @eps_x
fish hist @eps_vol
fish hist @eps_dev
fish hist @p_kPa
fish hist @q_kPa
fish hist @eta
fish hist @poro
fish hist @void_ratio

cycle 200

rblock property 'fric' @c_fri
cycle 800 calm 10

rblock attribute damp 0.2

cycle 10000 calm 10

;call 'control.dat'
