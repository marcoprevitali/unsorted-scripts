    y_t=height+wall.rotation.center.y(wall_top)-wall.rotation.center.y(wall_bottom)
     
  vol_ = x_w*y_t
  n_= 1.0 - sum / vol_
  n_1= 1-(1-n_interna_media)*(1.0 - 1.0 + sum0 / vol_) 
  n_1_star= 1.0 - sum20 / vol_ 
