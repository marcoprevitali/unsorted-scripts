def p_kPa
    x_w=width+wall.rotation.center.x(wall_right)-wall.rotation.center.x(wall_left)
    y_t=height+wall.rotation.center.y(wall_top)-wall.rotation.center.y(wall_bottom)
  
    x_fd=math.abs(wall.force.contact.x(wall_right))
    x_fs=math.abs(wall.force.contact.x(wall_left))
    x_for=0.5*(x_fd+x_fs)
    
    y_fa=math.abs(wall.force.contact.y(wall_top))
    y_fb=math.abs(wall.force.contact.y(wall_bottom))
    y_for=0.5*(y_fa+y_fb)
    
    y_str=y_for/x_w
    x_str=x_for/y_t
 
  
    p_kPa=(x_str+y_str)/2.0
    p_p=(x_str+y_str)/2.0
    
    q_kPa=y_str-x_str
    
    if x_str # 0. then
       ka=y_str/x_str
    else
       ka=0
    end_if
    
    if p_p # 0. then
       eta=q_kPa/p_p
    else
       eta=0
    end_if
    
end